syntax = "v1"

type (
	BaseResp {
		Code    int    `json:"code"`
		Message string `json:"message"`
	}
	// PageInfo 用于响应体（JSON 序列化）
	PageInfo {
		TotalCount int64 `json:"totalCount,optional"`
		PageNumber int   `json:"page"`
		PageSize   int   `json:"pageSize"`
	}
	// PageRequest 用于 GET 请求的 query 参数接收（form tag）
	PageRequest {
		PageNumber int `form:"page,default=1"`
		PageSize   int `form:"pageSize,default=10"`
	}
)

